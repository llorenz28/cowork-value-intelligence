    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "How to read this page",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "13pt",
                      "color": "#4B2D83"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Real: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#1B1F27"
                    }
                  },
                  {
                    "value": "Category-level task and modeled-value figures use observed Purview activity plus the selected value inputs. Cost and credit allocations populate only after a matching customer consumption export and the required contract inputs are connected; otherwise those fields remain blank. ",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#1B1F27"
                    }
                  },
                  {
                    "value": "Not yet available: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#1B1F27"
                    }
                  },
                  {
                    "value": "your tenant's audit export does not yet report which AI model handled each action, so rows are grouped under \"(Model data not available)\" rather than presented as a model comparison. ",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#1B1F27"
                    }
                  },
                  {
                    "value": "Why the ratio repeats: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#1B1F27"
                    }
                  },
                  {
                    "value": "with a single Model bucket, the efficiency ratio and average credits per task are mathematically guaranteed to match the overall average on every row -- real differences across models will only appear once more than one model is reported. ",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#1B1F27"
                    }
                  },
                  {
                    "value": "Take action: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#1B1F27"
                    }
                  },
                  {
                    "value": "nothing to configure here -- this page activates automatically with a genuine per-model comparison the moment your audit log starts reporting model attribution per action.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#1B1F27"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
