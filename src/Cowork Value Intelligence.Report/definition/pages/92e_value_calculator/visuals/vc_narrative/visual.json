                  {
                    "value": "How this is calculated",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "13pt",
                      "color": "#4B2D83"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Estimated value: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "8pt",
                      "color": "#1B1F27"
                    }
                  },
                  {
                    "value": "observed tasks x cited minutes saved / 60 x the selected labor rate. Adjusted value defaults to baseline and applies reinvestment, success/quality, and skill changes only when selected. Net value subtracts connected platform cost; ROI divides estimated value by that cost.",
                    "textStyle": {
                      "fontSize": "8pt",
                      "color": "#1B1F27"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Inputs and projection: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "8pt",
                      "color": "#1B1F27"
                    }
                  },
                  {
                    "value": "labor rate is synchronized across the report—select it once on any visible Labor rate control. Use Filters for credit-rate, contract, and billing inputs; use Advanced Assumptions for estimate basis and skill adjustments. Projected annual value annualizes the latest complete month. Confirm customer inputs with Finance before sharing.",
                    "textStyle": {
                      "fontSize": "8pt",
                      "color": "#1B1F27"
                    }
                  }
                ]
              }
            ]
