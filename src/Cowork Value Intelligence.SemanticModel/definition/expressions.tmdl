/// Fallback rate per credit used only if the "Rate per Credit" what-if slicer
/// has no selection. Note: M parameters are not usable inside DAX, so DAX
/// measures use the 0.01 literal fallback instead of this value.
expression DefaultRatePerCredit = 0.01 meta [IsParameterQuery=true, Type="Number", IsParameterQueryRequired=true]
	lineageTag: c4cde930-0eaa-4919-9545-37e297833dbc

/// Reusable, schema-tolerant CSV loader. Promotes headers and raises a clear
/// error if any of the 9 required MAC "Consumption - Users" columns is missing.
expression fnLoadCsv =
		let
			fn = (path as text) as table =>
				let
					Source = Csv.Document(File.Contents(path), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					Required = {"Display Name", "User Principal Name", "Monthly credit limit", "Monthly credits used", "User ID", "Microsoft 365 Copilot license", "Last activity date", "Session Count", "% Used"},
					Actual = Table.ColumnNames(Promoted),
					Missing = List.Difference(Required, Actual),
					Checked = if List.Count(Missing) > 0 then error "fnLoadCsv: missing required column(s): " & Text.Combine(Missing, ", ") else Promoted
				in
					Checked
		in
			fn
	lineageTag: 38d1df1b-008d-45ff-b72c-506be9198f23

/// Folder containing the RAW Microsoft Purview Audit Search export CSVs
/// (schema: RecordId, CreationDate, RecordType, Operation, UserId, AuditData, ...).
/// Point this at a folder holding one or more export parts. Only files with
/// that exact header shape are read; anything else in the folder is ignored.
/// Also drives Dim_User's dynamic Cowork-eligible-user detection: a user is
/// Cowork-eligible only when they appear in a CopilotInteraction record whose
/// AppHost contains "cowork" (case-insensitive).
expression CopilotAuditFolderPath = "C:\CoworkValueIntelligence\sample_data\purview_audit" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: 9a2d9d6e-9d0a-4b4a-8f4e-6a6a2b6c9a10

	annotation PBI_ResultType = Text

/// Path to the Microsoft admin center Cowork usage export CSV
/// (schema: UserPrincipalName, DisplayName,
/// TotalTasks, ScheduledTasks, UserInitiatedTasks, ActiveDays, LastActivityDate).
/// This is the ONLY source for the reported task total / scheduled-vs-user-
/// initiated split -- Fact_Tasks[Scheduled] is a hardcoded 0 (no real trigger-type
/// field exists in the Purview audit log itself, see 96_task_categories QA finding).
/// Fact_CoworkUsage distinguishes
