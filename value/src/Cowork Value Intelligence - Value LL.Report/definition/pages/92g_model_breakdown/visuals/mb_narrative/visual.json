          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "How to read this page",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "13pt",
                      "color": "#4B2D83"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Source status: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#1B1F27"
                    }
                  },
                  {
                    "value": "The banner identifies loaded model labels as observed, unavailable, or a QA fixture. Task and modeled-value figures use Purview activity plus selected value inputs. ",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#1B1F27"
                    }
                  },
                  {
                    "value": "Allocation method: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#1B1F27"
                    }
                  },
                  {
                    "value": "observed total credits and cost are distributed across model-category cells by task share. This reconciles to the tenant total but is not model-specific metering. ",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#1B1F27"
                    }
                  },
                  {
                    "value": "Interpretation: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#1B1F27"
                    }
                  },
                  {
                    "value": "cost per task is constant by allocation design; efficiency varies with the modeled value of each model's task mix. QA fixture model names must be replaced before customer use. ",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#1B1F27"
                    }
                  },
                  {
                    "value": "Take action: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#1B1F27"
                    }
                  },
                  {
                    "value": "load customer Purview exports through DataFolderPath. The page activates automatically when model attribution is present.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#1B1F27"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
