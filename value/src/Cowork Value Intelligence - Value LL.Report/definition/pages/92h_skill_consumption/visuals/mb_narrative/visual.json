        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "How to read this page",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "13pt",
                      "color": "#4B2D83"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Observed: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#1B1F27"
                    }
                  },
                  {
                    "value": "skill invocations come directly from Purview and stay filterable by user, date, Department, and Business Unit. ",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#1B1F27"
                    }
                  },
                  {
                    "value": "Allocated: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#1B1F27"
                    }
                  },
                  {
                    "value": "credits and cost are modeled by distributing each user’s observed consumption across that user’s skills according to invocation share; totals reconcile to observed credits and cost. ",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#1B1F27"
                    }
                  },
                  {
                    "value": "Value: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#1B1F27"
                    }
                  },
                  {
                    "value": "the default scope credits only direct 44-action classifications. Switch to Verified + representative to see the broader scenario. Ambiguous and unclassified records remain visible in coverage but receive no value.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#1B1F27"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
