table 'Skill Pick 02'
	lineageTag: be984db3-95d9-4bf2-8f12-39e5c432cc0c

	column Skill
		dataType: string
		lineageTag: bd7e0bf9-2c42-4fa0-a1c7-0f3446bfa296
