table 'Billing Model'
	lineageTag: 927c5906-a0d0-4b07-b0c1-07e65368266f

	/// Customer-selected billing model. Uses Credit-Priced until explicitly changed.
	measure 'Billing Mode' = SELECTEDVALUE('Billing Model'[Billing Model], "Credit-Priced")
		lineageTag: 778c0a0a-32da-47cb-bd57-8f0753d7e8e4

	column 'Billing Model'
		dataType: string
		lineageTag: ef803609-7611-4dcd-ac38-68375cc0bdeb
		summarizeBy: none
		sourceColumn: [Value]

	partition 'Billing Model' = calculated
		mode: import
		source = DATATABLE("Value", STRING, {{"Credit-Priced"}, {"License-Included"}, {"Prepaid"}, {"Hybrid"}, {"Monthly Committed"}})
