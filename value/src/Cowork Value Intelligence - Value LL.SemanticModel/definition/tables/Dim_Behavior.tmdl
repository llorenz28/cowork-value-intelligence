table Dim_Behavior
	lineageTag: b47028ea-b92e-4964-b7bd-b813c10c8dc8

	column BehaviorKey
		dataType: int64
		isHidden
		isKey
		lineageTag: 132c37c8-a7ce-48be-9be3-aa5e42825b48
		summarizeBy: none
		sourceColumn: BehaviorKey

	column Behavior
		dataType: string
		lineageTag: 1675fbb7-e6ba-4893-bd33-ef00432e5cc4
		summarizeBy: none
		sourceColumn: Behavior

	column Category
		dataType: string
		lineageTag: 6ea3d4a8-b9a4-4bee-aa03-97c8dbdff6e1
		summarizeBy: none
		sourceColumn: Category

	column CategoryKey = LOOKUPVALUE(Dim_TaskCategory[CategoryKey], Dim_TaskCategory[Category], Dim_Behavior[Category])
		dataType: int64
		isHidden
		lineageTag: 91b00005-4e3b-47c9-a005-7f3c7e020005
		summarizeBy: none

	/// Value tier of the behavior: High (>=30 baseline min), Mid (10-29), Low (<10). Derived from Human Time Estimates.
	column 'Value Tier' =
			VAR m = LOOKUPVALUE('Human Time Estimates'[HumanBaselineMin], 'Human Time Estimates'[Behavior], Dim_Behavior[Behavior])
			RETURN SWITCH(TRUE(), m >= 30, "High", m >= 10, "Mid", "Low")
		dataType: string
		lineageTag: 7a1c9d2e-4b6f-4a10-9c3e-2f81ab55c001
		summarizeBy: none

	/// Typical human baseline minutes for the behavior (attribute, not summed). Derived from Human Time Estimates.
	column 'Typical Minutes' = LOOKUPVALUE('Human Time Estimates'[HumanBaselineMin], 'Human Time Estimates'[Behavior], Dim_Behavior[Behavior])
		dataType: int64
		formatString: #,0
		lineageTag: 7a1c9d2e-4b6f-4a10-9c3e-2f81ab55c002
		summarizeBy: none

	column Confidence = LOOKUPVALUE('Human Time Estimates'[Confidence], 'Human Time Estimates'[Behavior], Dim_Behavior[Behavior])
		dataType: string
		lineageTag: 91b00001-4e3b-47c9-a001-7f3c7e020001
		summarizeBy: none

	column 'Value Outcome' = LOOKUPVALUE('Human Time Estimates'[ValueOutcome], 'Human Time Estimates'[Behavior], Dim_Behavior[Behavior])
		dataType: string
		lineageTag: 91b00002-4e3b-47c9-a002-7f3c7e020002
		summarizeBy: none

	column 'Research Source' = LOOKUPVALUE('Human Time Estimates'[PrimarySource], 'Human Time Estimates'[Behavior], Dim_Behavior[Behavior])
		dataType: string
		lineageTag: 91b00003-4e3b-47c9-a003-7f3c7e020003
		summarizeBy: none

	column 'Research URL' = LOOKUPVALUE('Human Time Estimates'[SourceURL], 'Human Time Estimates'[Behavior], Dim_Behavior[Behavior])
		dataType: string
		lineageTag: 91b00004-4e3b-47c9-a004-7f3c7e020004
		dataCategory: WebUrl
		summarizeBy: none

	partition Dim_Behavior = m
		mode: import
		source =
